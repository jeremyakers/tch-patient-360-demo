### Data Quality Validation
```bash
# Check for data quality issues across source systems
snow sql -q "
-- Check for orphaned records
SELECT 'Encounters without patients' as issue, COUNT(*) as count
FROM EPIC.ENCOUNTERS e
LEFT JOIN EPIC.PATIENTS p ON e.patient_id = p.patient_id
WHERE p.patient_id IS NULL

UNION ALL

-- Check for financial records without encounters  
SELECT 'Financial records without encounters', COUNT(*)
FROM ORACLE_ERP.ENCOUNTER_FINANCIALS f
LEFT JOIN EPIC.ENCOUNTERS e ON f.encounter_id = e.encounter_id
WHERE e.encounter_id IS NULL

UNION ALL

-- Check for engagement records without patients
SELECT 'Engagement records without patients', COUNT(*)
FROM SALESFORCE.PATIENT_PORTAL_ACTIVITY s
LEFT JOIN EPIC.PATIENTS p ON s.patient_id = p.patient_id
WHERE p.patient_id IS NULL;" \
  --account SFSENORTHAMERICA-DEMO_JAKERS \
  --user TCH_PATIENT_360_USER \
  --role TCH_PATIENT_360_ROLE \
  --database TCH_PATIENT_360_POC \
  --warehouse TCH_COMPUTE_WH
```

