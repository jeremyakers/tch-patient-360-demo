### Data Generation Standards
```python
import random
import faker
from datetime import datetime, timedelta
from typing import List, Dict

class PediatricDataGenerator:
    """Generate realistic pediatric healthcare data for PoC demonstration."""
    
    def __init__(self, seed: int = 42):
        """Initialize with consistent seed for reproducible data."""
        random.seed(seed)
        self.fake = faker.Faker()
        faker.Faker.seed(seed)
        
    def generate_patient_demographics(self, count: int) -> List[Dict]:
        """
        Generate realistic pediatric patient demographics.
        
        Args:
            count: Number of patients to generate
            
        Returns:
            List of patient demographic dictionaries
        """
        patients = []
        
        for i in range(count):
            # Generate age-appropriate data
            age = self._generate_pediatric_age()
            birth_date = datetime.now() - timedelta(days=age * 365.25)
            
            patient = {
                'patient_id': f"TCH-{i+1:06d}",
                'mrn': f"MRN{i+1:08d}",
                'first_name': self.fake.first_name(),
                'last_name': self.fake.last_name(),
                'date_of_birth': birth_date.date(),
                'gender': random.choice(['M', 'F']),
                'race': self._generate_race(),
                'ethnicity': self._generate_ethnicity(),
                'zip_code': self._generate_houston_zip(),
                'insurance_type': self._generate_insurance_type()
            }
            patients.append(patient)
            
        return patients
    
    def _generate_pediatric_age(self) -> int:
        """Generate age following pediatric population distribution."""
        # Higher concentration in younger ages (0-5)
        weights = [25, 20, 15, 10, 10, 8, 6, 4, 2] + [1] * 13  # 0-21 years
        return random.choices(range(22), weights=weights)[0]
```

