## Performance Guidelines

### Query Optimization
```sql
-- Use appropriate clustering keys
ALTER TABLE conformed.encounters 
CLUSTER BY (patient_id, encounter_date);

-- Leverage result caching
-- Avoid SELECT * in production queries
-- Use LIMIT for exploratory queries
-- Consider materialized views for complex aggregations

-- Example of optimized query structure
WITH patient_encounters AS (
    SELECT 
        patient_id,
        encounter_date,
        department,
        ROW_NUMBER() OVER (PARTITION BY patient_id ORDER BY encounter_date DESC) as rn
    FROM conformed.encounters
    WHERE encounter_date >= DATEADD('year', -1, CURRENT_DATE())
),
recent_encounters AS (
    SELECT *
    FROM patient_encounters
    WHERE rn <= 5  -- Last 5 encounters per patient
)
SELECT 
    p.patient_id,
    p.first_name,
    p.last_name,
    re.encounter_date,
    re.department
FROM conformed.patient_master p
    INNER JOIN recent_encounters re ON p.patient_id = re.patient_id
ORDER BY p.last_name, p.first_name, re.encounter_date DESC;
```

