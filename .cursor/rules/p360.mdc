PATIENT_DEMOGRAPHICS
ENCOUNTER_SUMMARY
LAB_RESULTS_FACT

-- Column Names: Use descriptive, lowercase names with underscores
patient_id
encounter_date
lab_result_value

-- Schema Names: Use lowercase with underscores
