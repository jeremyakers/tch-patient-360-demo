-- Create patient master dynamic table for real-time patient data
-- Updates every 5 minutes to reflect latest Epic data
-- Includes calculated fields for age and risk stratification
CREATE OR REPLACE DYNAMIC TABLE conformed.patient_master
TARGET_LAG = '5 minutes'
WAREHOUSE = compute_wh
AS
SELECT 
    patient_id,
    -- Calculate current age for pediatric care protocols
    DATEDIFF('year', date_of_birth, CURRENT_DATE()) AS current_age,
    -- Flag high-risk patients based on chronic conditions
    CASE 
        WHEN chronic_conditions > 2 THEN 'HIGH_RISK'
        WHEN chronic_conditions = 1 THEN 'MODERATE_RISK'
        ELSE 'LOW_RISK'
    END AS risk_category
FROM raw_data.epic.patients;
```

