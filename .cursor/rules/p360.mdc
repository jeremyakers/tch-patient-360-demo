import pytest
from data_generation.patient_generator import PediatricDataGenerator

class TestPediatricDataGenerator:
    """Test suite for pediatric data generation."""
    
    def setup_method(self):
        """Setup test environment."""
        self.generator = PediatricDataGenerator(seed=42)
    
    def test_patient_age_distribution(self):
        """Test that generated ages follow pediatric distribution."""
        patients = self.generator.generate_patient_demographics(1000)
        ages = [self.generator._calculate_age(p['date_of_birth']) for p in patients]
        
        # Verify all ages are within pediatric range
        assert all(0 <= age <= 21 for age in ages)
        
        # Verify higher concentration in younger ages
        young_patients = sum(1 for age in ages if age <= 5)
        assert young_patients > len(patients) * 0.4  # At least 40% under 6
    
    def test_realistic_conditions_prevalence(self):
        """Test that condition prevalence matches real-world data."""
        patients = self.generator.generate_patient_demographics(10000)
        conditions = self.generator.assign_conditions(patients)
        
        asthma_rate = sum(1 for c in conditions if 'asthma' in c) / len(patients)
        assert 0.07 <= asthma_rate <= 0.12  # 7-12% asthma prevalence
