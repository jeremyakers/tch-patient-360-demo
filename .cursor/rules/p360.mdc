conformed
presentation
ai_ml
```

### SQL Style Guidelines
```sql
-- Use consistent formatting
SELECT 
    patient_id,
    first_name,
    last_name,
    date_of_birth,
    DATEDIFF('year', date_of_birth, CURRENT_DATE()) AS age
FROM conformed.patient_master
WHERE age BETWEEN 0 AND 21
ORDER BY last_name, first_name;

-- Always use explicit JOIN syntax
SELECT 
    p.patient_id,
    p.first_name,
    e.encounter_date,
    e.department
FROM conformed.patient_master p
    INNER JOIN conformed.encounters e 
        ON p.patient_id = e.patient_id
WHERE e.encounter_date >= DATEADD('month', -12, CURRENT_DATE());

-- Use meaningful aliases
-- Good: p for patients, e for encounters
-- Bad: a, b, c, t1, t2
```

### Dynamic Tables Best Practices
```sql
-- Always specify TARGET_LAG appropriately
-- Design tables such that they can be refreshed incrementally. Avoid non deterministic functions like current_date, current_timestamp, etc
CREATE OR REPLACE DYNAMIC TABLE conformed.patient_summary
TARGET_LAG = '15 minutes'  -- Consider business requirements
WAREHOUSE = compute_wh
AS
SELECT 
    patient_id,
    COUNT(*) AS total_encounters,
    MAX(encounter_date) AS last_encounter_date,
    AVG(length_of_stay) AS avg_length_of_stay
FROM raw_data.epic.encounters
GROUP BY patient_id;

-- Include comments explaining business logic
-- Use appropriate refresh frequencies based on data velocity
-- Consider dependencies between dynamic tables
```

## Python Coding Standards

### General Python Guidelines
```python
# Use type hints for better code documentation
from typing import Dict, List, Optional, Tuple
import pandas as pd
import snowflake.connector

def get_patient_data(patient_id: str, connection: snowflake.connector.SnowflakeConnection) -> Optional[Dict]:
    """
    Retrieve comprehensive patient data from Snowflake.
    
    Args:
        patient_id: Unique patient identifier
        connection: Active Snowflake connection
        
    Returns:
        Dictionary containing patient data or None if not found
    """
    query = """
    SELECT 
        patient_id,
        first_name,
        last_name,
        date_of_birth,
        gender
    FROM presentation.patient_360
    WHERE patient_id = %s
    """
    
    try:
        cursor = connection.cursor()
        cursor.execute(query, (patient_id,))
        result = cursor.fetchone()
        
        if result:
            return {
                'patient_id': result[0],
                'first_name': result[1],
                'last_name': result[2],
                'date_of_birth': result[3],
                'gender': result[4]
            }
        return None
        
    except Exception as e:
        logging.error(f"Error retrieving patient data: {e}")
        return None
    finally:
        cursor.close()
```

